# Copy to .env for docker compose. These are local-only development credentials; never reuse them elsewhere.
QUANTARUN_DB_NAME=quantarun
QUANTARUN_DB_USER=quantarun
QUANTARUN_DB_PASSWORD=change-me-local-only
QUANTARUN_DB_PORT=5432
QUANTARUN_WEB_PORT=3000
# Operator token for project administration (min. 32 chars). Generate your own: openssl rand -hex 32
QUANTARUN_ADMIN_TOKEN=local-dev-admin-token-change-me-0123456789
# Shared secret workers use to register with the control plane (min. 32 chars).
QUANTARUN_WORKER_BOOTSTRAP_TOKEN=local-dev-worker-bootstrap-change-me-0123
# Chaos experiments (docs/CHAOS.md): predefined faults the operator can aim at the local workers. Off by default.
QUANTARUN_CHAOS_ENABLED=false
